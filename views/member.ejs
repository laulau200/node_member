<!-- member.ejs-->
<!DOCTYPE html>
<html lang="en" class="dark scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= pageTitle %></title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen">

    <!-- Top Navigation Bar -->
    <nav class="bg-slate-900 border-b border-slate-800 sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 h-16 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <span class="text-xl font-black text-white">PULSE<span class="text-yellow-400">.RC</span></span>
            </div>

            <div class="flex items-center gap-4">
                <div class="text-right text-xs">
                    <span class="block font-bold text-white"><%= user.name %></span>
                    <span class="block text-[10px] text-yellow-400 uppercase font-mono"><%= user.tier %></span>
                </div>
                <a href="/logout" class="bg-rose-600 hover:bg-rose-500 text-white text-xs px-3 py-1.5 rounded font-bold uppercase">Logout</a>
            </div>
        </div>
    </nav>

    <!-- Protected Hero Dashboard Section -->
    <header class="py-10 bg-slate-900/50 border-b border-slate-800">
        <div class="max-w-7xl mx-auto px-4">
            <h1 class="text-3xl font-black uppercase text-white">
                WELCOME BACK, <span class="text-yellow-400"><%= user.name %></span>
            </h1>
            <p class="text-slate-400 text-sm mt-1">Logged in as: <%= user.email %> (<%= user.role.toUpperCase() %>)</p>
            
            <div class="grid grid-cols-3 gap-4 mt-6 max-w-lg text-center font-mono">
                <div class="bg-slate-900 p-3 rounded-lg border border-slate-800">
                    <span class="text-[10px] text-slate-500 block uppercase">Weekly Km</span>
                    <span class="text-lg font-bold text-yellow-400"><%= user.stats.weeklyKm %> KM</span>
                </div>
                <div class="bg-slate-900 p-3 rounded-lg border border-slate-800">
                    <span class="text-[10px] text-slate-500 block uppercase">Target Pace</span>
                    <span class="text-lg font-bold text-cyan-400"><%= user.stats.pace %></span>
                </div>
                <div class="bg-slate-900 p-3 rounded-lg border border-slate-800">
                    <span class="text-[10px] text-slate-500 block uppercase">Squad Rank</span>
                    <span class="text-lg font-bold text-rose-500"><%= user.stats.rank %></span>
                </div>
            </div>
        </div>
    </header>

    <!-- News Section -->
    <section class="py-10 border-b border-slate-800 max-w-7xl mx-auto px-4">
        <h2 class="text-xl font-bold mb-6 text-white uppercase">Member News</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <% news.forEach(function(item) { %>
                <div class="bg-slate-900 rounded-xl border border-slate-800 p-4">
                    <span class="text-[10px] font-mono text-yellow-400 font-bold"><%= item.category %></span>
                    <h3 class="font-bold text-white mt-1"><%= item.title %></h3>
                    <p class="text-xs text-slate-400 mt-2"><%= item.snippet %></p>
                </div>
            <% }); %>
        </div>
    </section>

    <!-- Results Table -->
    <section class="py-10 max-w-7xl mx-auto px-4">
        <h2 class="text-xl font-bold mb-6 text-white uppercase">Recent Results</h2>
        <table class="w-full text-left text-xs bg-slate-900 rounded-xl overflow-hidden">
            <thead class="bg-slate-950 text-slate-400 font-mono uppercase">
                <tr>
                    <th class="p-3">Rank</th>
                    <th class="p-3">Athlete</th>
                    <th class="p-3">Distance</th>
                    <th class="p-3">Time</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-800">
                <% results.forEach(function(r) { %>
                    <tr class="<%= r.name === user.name ? 'bg-yellow-400/10 font-bold' : '' %>">
                        <td class="p-3 text-yellow-400">#<%= r.rank %></td>
                        <td class="p-3 font-bold text-white"><%= r.name %></td>
                        <td class="p-3 text-cyan-400"><%= r.distance %></td>
                        <td class="p-3 font-mono text-rose-400"><%= r.time %></td>
                    </tr>
                <% }); %>
            </tbody>
        </table>
    </section>

</body>
</html>