            <pre class="bg-slate-950 p-6 rounded-xl border border-pulse-border text-xs font-mono text-slate-300 overflow-x-auto leading-relaxed"><code id="code-ejs-text">&lt;!DOCTYPE html&gt;
&lt;html lang="en" class="dark scroll-smooth"&gt;
&lt;head&gt;
    &lt;meta charset="UTF-8"&gt;
    &lt;meta name="viewport" content="width=device-width, initial-scale=1.0"&gt;
    &lt;title&gt;&lt;%= pageTitle %&gt;&lt;/title&gt;
    &lt;script src="https://cdn.tailwindcss.com"&gt;&lt;/script&gt;
&lt;/head&gt;
&lt;body class="bg-slate-950 text-slate-100 min-h-screen"&gt;

    &lt;!-- Top Navigation Bar --&gt;
    &lt;nav class="bg-slate-900 border-b border-slate-800 sticky top-0 z-50"&gt;
        &lt;div class="max-w-7xl mx-auto px-4 h-16 flex items-center justify-between"&gt;
            &lt;div class="flex items-center gap-3"&gt;
                &lt;span class="text-xl font-black text-white"&gt;PULSE&lt;span class="text-yellow-400"&gt;.RC&lt;/span&gt;&lt;/span&gt;
            &lt;/div&gt;

            &lt;div class="flex items-center gap-4"&gt;
                &lt;div class="text-right text-xs"&gt;
                    &lt;span class="block font-bold text-white"&gt;&lt;%= user.name %&gt;&lt;/span&gt;
                    &lt;span class="block text-[10px] text-yellow-400 uppercase font-mono"&gt;&lt;%= user.tier %&gt;&lt;/span&gt;
                &lt;/div&gt;
                &lt;a href="/logout" class="bg-rose-600 hover:bg-rose-500 text-white text-xs px-3 py-1.5 rounded font-bold uppercase"&gt;Logout&lt;/a&gt;
            &lt;/div&gt;
        &lt;/div&gt;
    &lt;/nav&gt;

    &lt;!-- Protected Hero Dashboard Section --&gt;
    &lt;header class="py-10 bg-slate-900/50 border-b border-slate-800"&gt;
        &lt;div class="max-w-7xl mx-auto px-4"&gt;
            &lt;h1 class="text-3xl font-black uppercase text-white"&gt;
                WELCOME BACK, &lt;span class="text-yellow-400"&gt;&lt;%= user.name %&gt;&lt;/span&gt;
            &lt;/h1&gt;
            &lt;p class="text-slate-400 text-sm mt-1"&gt;Logged in as: &lt;%= user.email %&gt; (&lt;%= user.role.toUpperCase() %&gt;)&lt;/p&gt;
            
            &lt;div class="grid grid-cols-3 gap-4 mt-6 max-w-lg text-center font-mono"&gt;
                &lt;div class="bg-slate-900 p-3 rounded-lg border border-slate-800"&gt;
                    &lt;span class="text-[10px] text-slate-500 block uppercase"&gt;Weekly Km&lt;/span&gt;
                    &lt;span class="text-lg font-bold text-yellow-400"&gt;&lt;%= user.stats.weeklyKm %&gt; KM&lt;/span&gt;
                &lt;/div&gt;
                &lt;div class="bg-slate-900 p-3 rounded-lg border border-slate-800"&gt;
                    &lt;span class="text-[10px] text-slate-500 block uppercase"&gt;Target Pace&lt;/span&gt;
                    &lt;span class="text-lg font-bold text-cyan-400"&gt;&lt;%= user.stats.pace %&gt;&lt;/span&gt;
                &lt;/div&gt;
                &lt;div class="bg-slate-900 p-3 rounded-lg border border-slate-800"&gt;
                    &lt;span class="text-[10px] text-slate-500 block uppercase"&gt;Squad Rank&lt;/span&gt;
                    &lt;span class="text-lg font-bold text-rose-500"&gt;&lt;%= user.stats.rank %&gt;&lt;/span&gt;
                &lt;/div&gt;
            &lt;/div&gt;
        &lt;/div&gt;
    &lt;/header&gt;

    &lt;!-- News Section --&gt;
    &lt;section class="py-10 border-b border-slate-800 max-w-7xl mx-auto px-4"&gt;
        &lt;h2 class="text-xl font-bold mb-6 text-white uppercase"&gt;Member News&lt;/h2&gt;
        &lt;div class="grid grid-cols-1 md:grid-cols-3 gap-6"&gt;
            &lt;% news.forEach(function(item) { %&gt;
                &lt;div class="bg-slate-900 rounded-xl border border-slate-800 p-4"&gt;
                    &lt;span class="text-[10px] font-mono text-yellow-400 font-bold"&gt;&lt;%= item.category %&gt;&lt;/span&gt;
                    &lt;h3 class="font-bold text-white mt-1"&gt;&lt;%= item.title %&gt;&lt;/h3&gt;
                    &lt;p class="text-xs text-slate-400 mt-2"&gt;&lt;%= item.snippet %&gt;&lt;/p&gt;
                &lt;/div&gt;
            &lt;% }); %&gt;
        &lt;/div&gt;
    &lt;/section&gt;

    &lt;!-- Results Table --&gt;
    &lt;section class="py-10 max-w-7xl mx-auto px-4"&gt;
        &lt;h2 class="text-xl font-bold mb-6 text-white uppercase"&gt;Recent Results&lt;/h2&gt;
        &lt;table class="w-full text-left text-xs bg-slate-900 rounded-xl overflow-hidden"&gt;
            &lt;thead class="bg-slate-950 text-slate-400 font-mono uppercase"&gt;
                &lt;tr&gt;
                    &lt;th class="p-3"&gt;Rank&lt;/th&gt;
                    &lt;th class="p-3"&gt;Athlete&lt;/th&gt;
                    &lt;th class="p-3"&gt;Distance&lt;/th&gt;
                    &lt;th class="p-3"&gt;Time&lt;/th&gt;
                &lt;/tr&gt;
            &lt;/thead&gt;
            &lt;tbody class="divide-y divide-slate-800"&gt;
                &lt;% results.forEach(function(r) { %&gt;
                    &lt;tr class="&lt;%= r.name === user.name ? 'bg-yellow-400/10 font-bold' : '' %&gt;"&gt;
                        &lt;td class="p-3 text-yellow-400"&gt;#&lt;%= r.rank %&gt;&lt;/td&gt;
                        &lt;td class="p-3 font-bold text-white"&gt;&lt;%= r.name %&gt;&lt;/td&gt;
                        &lt;td class="p-3 text-cyan-400"&gt;&lt;%= r.distance %&gt;&lt;/td&gt;
                        &lt;td class="p-3 font-mono text-rose-400"&gt;&lt;%= r.time %&gt;&lt;/td&gt;
                    &lt;/tr&gt;
                &lt;% }); %&gt;
            &lt;/tbody&gt;
        &lt;/table&gt;
    &lt;/section&gt;

&lt;/body&gt;
&lt;/html&gt;</code></pre>
        </div>
    </div>

    <div id="video-modal" class="fixed inset-0 bg-black/80 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
        <div class="bg-pulse-panel border border-pulse-border w-full max-w-3xl rounded-2xl overflow-hidden shadow-2xl relative">
            <div class="p-4 bg-slate-900 border-b border-pulse-border flex justify-between items-center">
                <h4 id="modal-video-title" class="font-bold text-white text-sm">Video Route Preview</h4>
                <button onclick="closeVideoModal()" class="text-slate-400 hover:text-white"><i class="fa-solid fa-xmark text-lg"></i></button>
            </div>
            <div class="aspect-video bg-black flex items-center justify-center relative">
                <img id="modal-video-poster" src="" class="w-full h-full object-cover opacity-60">
                <div class="absolute inset-0 flex flex-col items-center justify-center gap-3">
                    <div class="w-16 h-16 rounded-full bg-pulse-crimson flex items-center justify-center text-white text-2xl shadow-xl animate-pulse">
                        <i class="fa-solid fa-play ml-1"></i>
                    </div>
                    <span class="text-xs font-mono text-white bg-black/70 px-3 py-1 rounded-full border border-pulse-border">Simulating Stream Route Playback</span>
                </div>
            </div>
            <div class="p-4 bg-slate-900 text-xs text-slate-300 flex justify-between items-center font-mono">
                <span>Elevation profile &amp; GPX synced</span>
                <button onclick="closeVideoModal()" class="bg-slate-800 px-4 py-1.5 rounded-lg text-white font-bold">Close Preview</button>
            </div>
        </div>
    </div>

    <script>
        // Mock Session State
        let currentUser = {
            authenticated: true,
            email: 'user@pulse.run',
            name: 'Alex Rivera',
            role: 'member',
            tier: 'Pro Athlete Member',
            stats: { weeklyKm: 68.4, pace: '3:52 /km', rank: '#2 Overall' }
        };

        // Mock Datasets
        const newsData = [
            {
                id: 1,
                title: 'Autumn Marathon Prep Block Starts Saturday',
                category: 'Training',
                date: 'OCT 05, 2026',
                readTime: '3 min read',
                image: 'https://images.unsplash.com/photo-1452626038306-9aae5e071dd3?auto=format&fit=crop&w=600&q=80',
                snippet: 'Structured 10-week build program featuring weekly long workout runs and intra-race fueling practice.'
            },
            {
                id: 2,
                title: 'PULSE 10K Glow Night Race Details',
                category: 'Event',
                date: 'OCT 18, 2026',
                readTime: '2 min read',
                image: 'https://images.unsplash.com/photo-1530549387789-4c1017266635?auto=format&fit=crop&w=600&q=80',
                snippet: 'Glowsticks, live DJs along the river route, and post-race refuel party at squad HQ.'
            },
            {
                id: 3,
                title: 'Podium Clean Sweep at City Half Marathon',
                category: 'Race Report',
                date: 'SEP 22, 2026',
                readTime: '5 min read',
                image: 'https://images.unsplash.com/photo-1516483638261-f4dbaf036963?auto=format&fit=crop&w=600&q=80',
                snippet: 'PULSE runners dominated both men\'s and women\'s divisions in last weekend\'s flagship race.'
            }
        ];

        const adviceData = [
            {
                id: 1,
                title: 'Carbo-Loading & Intra-Race Hydrogel Timing',
                category: 'Nutrition',
                icon: 'fa-wheat-awn',
                text: 'Target 7-9g carbs per kg body weight 36h before race day. Take fructose/glucose hydrogels every 25-30 mins during efforts over 75 mins.'
            },
            {
                id: 2,
                title: 'Negative Splits & Zone 2 Base Building',
                category: 'Pacing',
                icon: 'fa-gauge-high',
                text: 'Keep 80% of weekly volume strictly below aerobic threshold (Zone 2) to increase capillary density without incurring neuromuscular fatigue.'
            },
            {
                id: 3,
                title: 'Achilles & Plantar Fascia Prehab Protocols',
                category: 'Recovery',
                icon: 'fa-kit-medical',
                text: 'Perform 3x15 heavy eccentric calf drops twice a week to strengthen foot tendons and prevent overuse injuries during peak volume weeks.'
            },
            {
                id: 4,
                title: 'Carbon Plated Shoe Rotation Strategy',
                category: 'Gear',
                icon: 'fa-shoe-prints',
                text: 'Reserve stiff carbon racers for specific race-pace workouts to preserve shoe foam pop and minimize joint stress during recovery runs.'
            }
        ];

        const videoData = [
            {
                id: 1,
                title: 'River Trail 15K Tempo Loop Recon',
                duration: '08:45',
                distance: '15.2 km',
                elevation: '+140m',
                pace: '3:45 /km',
                thumbnail: 'https://images.unsplash.com/photo-1516483638261-f4dbaf036963?auto=format&fit=crop&w=600&q=80'
            },
            {
                id: 2,
                title: 'Track Tuesday: 800m Interval Breakdown',
                duration: '05:20',
                distance: '8.0 km Total',
                elevation: '+0m',
                pace: '2:55 /km',
                thumbnail: 'https://images.unsplash.com/photo-1461896836934-ffe607ba8211?auto=format&fit=crop&w=600&q=80'
            },
            {
                id: 3,
                title: 'Alpine Ridge Singletrack POV Run',
                duration: '12:10',
                distance: '28.5 km',
                elevation: '+1120m',
                pace: '5:10 /km',
                thumbnail: 'https://images.unsplash.com/photo-1476480862126-209bfaa8edc8?auto=format&fit=crop&w=600&q=80'
            }
        ];

        const resultsData = [
            { rank: 1, name: 'David Kiptoo', distance: 'Half-Marathon', time: '1:04:12', pace: '3:02 /km', cat: 'M Open', pb: true },
            { rank: 2, name: 'Alex Rivera', distance: 'Half-Marathon', time: '1:07:45', pace: '3:12 /km', cat: 'M Open', pb: true },
            { rank: 3, name: 'Sophia Chen', distance: 'Half-Marathon', time: '1:12:08', pace: '3:25 /km', cat: 'F Open', pb: true },
            { rank: 4, name: 'Liam O\'Connor', distance: '10K', time: '30:15', pace: '3:01 /km', cat: 'M 30-34', pb: true },
            { rank: 5, name: 'Emma Watson', distance: '10K', time: '33:40', pace: '3:22 /km', cat: 'F 25-29', pb: false }
        ];

        const coachesData = [
            { name: 'Sarah Jenkins', role: 'Head Coach', email: 'sarah.jenkins@pulse.run', image: 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=150&q=80', desc: '5x Marathon finisher & IAAF Level 3 Endurance specialist.' },
            { name: 'Marcus Vance', role: 'Marathon & Ultra', email: 'marcus.vance@pulse.run', image: 'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=150&q=80', desc: 'Mountain ultra specialist with focus on pacing & strain recovery.' },
            { name: 'Elena Rostova', role: 'Track & Speedwork', email: 'elena.rostova@pulse.run', image: 'https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&fit=crop&w=150&q=80', desc: 'Biomechanics expert specializing in running economy drills.' },
            { name: 'David Miller', role: 'Academy Coach', email: 'david.miller@pulse.run', image: 'https://images.unsplash.com/photo-1500648767791-00dcc994a43e?auto=format&fit=crop&w=150&q=80', desc: 'Developing new athletes and structured 5K to 10K progressions.' }
        ];

        function initApp() {
            renderAuthWidget();
            renderNews();
            filterAdvice('all');
            renderVideos();
            renderResults();
            renderCoaches();
        }

        function switchTab(tabId) {
            document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
            document.getElementById('tab-' + tabId).classList.add('active');

            document.getElementById('view-dashboard').classList.add('hidden');
            document.getElementById('view-server').classList.add('hidden');
            document.getElementById('view-ejs').classList.add('hidden');

            document.getElementById('view-' + tabId).classList.remove('hidden');
        }

        function renderAuthWidget() {
            const container = document.getElementById('auth-simulator-status');
            const bannerText = document.getElementById('auth-banner-text');

            if (currentUser.authenticated) {
                container.innerHTML = `
                    <div class="flex items-center gap-2">
                        <span class="text-xs font-mono text-pulse-yellow font-bold hidden sm:inline">${currentUser.name}</span>
                        <button onclick="toggleAuth(false)" class="bg-pulse-crimson/20 hover:bg-pulse-crimson text-pulse-crimson hover:text-white border border-pulse-crimson/40 px-3 py-1 rounded-lg text-xs font-bold transition">
                            Simulate Logout
                        </button>
                    </div>
                `;
                bannerText.innerHTML = `Viewing Protected Member Dashboard as <strong>${currentUser.email}</strong> (${currentUser.tier})`;
                document.getElementById('hero-user-name').innerText = currentUser.name;
                document.getElementById('card-user-name').innerText = currentUser.name;
                document.getElementById('card-user-tier').innerText = currentUser.tier;
            } else {
                container.innerHTML = `
                    <button onclick="toggleAuth(true)" class="bg-pulse-yellow hover:bg-yellow-300 text-pulse-dark px-3 py-1 rounded-lg text-xs font-black uppercase transition">
                        Simulate Member Login
                    </button>
                `;
                bannerText.innerHTML = `<span class="text-rose-400 font-bold">UNAUTHENTICATED ACCESS SIMULATED: Express 'requireAuth' middleware will redirect /member requests to /login.</span>`;
            }
        }

        function toggleAuth(authenticated) {
            currentUser.authenticated = authenticated;
            renderAuthWidget();
            if (!authenticated) {
                // If unauthenticated, show prompt
                setTimeout(() => {
                    alert("Middleware Redirect Triggered!\n\nUnauthenticated access to '/member' detected. Express server calls res.redirect('/login').");
                }, 100);
            }
        }

        function renderNews() {
            const container = document.getElementById('news-container');
            container.innerHTML = newsData.map(item => `
                <div class="bg-pulse-panel rounded-2xl border border-pulse-border overflow-hidden flex flex-col justify-between hover:border-pulse-crimson/50 transition">
                    <div>
                        <div class="relative h-40 overflow-hidden">
                            <img src="${item.image}" class="w-full h-full object-cover">
                            <span class="absolute top-3 left-3 bg-pulse-dark/80 backdrop-blur-md border border-pulse-border text-pulse-yellow text-[10px] font-mono px-2 py-0.5 rounded uppercase font-bold">
                                ${item.category}
                            </span>
                        </div>
                        <div class="p-5">
                            <h3 class="text-base font-bold text-white">${item.title}</h3>
                            <p class="text-xs text-slate-400 mt-2 leading-relaxed">${item.snippet}</p>
                        </div>
                    </div>
                    <div class="px-5 pb-5 pt-0 text-[10px] text-slate-500 font-mono flex justify-between border-t border-pulse-border/40 mt-2 pt-3">
                        <span><i class="fa-regular fa-calendar mr-1"></i>${item.date}</span>
                        <span><i class="fa-regular fa-clock mr-1"></i>${item.readTime}</span>
                    </div>
                </div>
            `).join('');
        }

        function filterAdvice(cat) {
            // Update filter buttons UI
            const buttons = document.querySelectorAll('#advice-filters button');
            buttons.forEach(btn => {
                if (btn.innerText.toLowerCase() === cat.toLowerCase() || (cat === 'all' && btn.innerText === 'All')) {
                    btn.classList.add('active');
                } else {
                    btn.classList.remove('active');
                }
            });

            const filtered = cat === 'all' ? adviceData : adviceData.filter(a => a.category.toLowerCase() === cat.toLowerCase());
            const container = document.getElementById('advice-container');

            container.innerHTML = filtered.map(adv => `
                <div class="bg-pulse-panel p-6 rounded-2xl border border-pulse-border relative overflow-hidden">
                    <div class="flex items-center gap-3 mb-3">
                        <div class="w-8 h-8 rounded-lg bg-pulse-cyan/10 border border-pulse-cyan/30 flex items-center justify-center text-pulse-cyan text-xs">
                            <i class="fa-solid ${adv.icon}"></i>
                        </div>
                        <div>
                            <span class="text-[10px] font-mono text-pulse-cyan font-bold uppercase">${adv.category}</span>
                            <h3 class="text-sm font-bold text-white">${adv.title}</h3>
                        </div>
                    </div>
                    <p class="text-xs text-slate-300 leading-relaxed">${adv.text}</p>
                </div>
            `).join('');
        }

        function renderVideos() {
            const container = document.getElementById('video-container');
            container.innerHTML = videoData.map(v => `
                <div class="bg-pulse-panel rounded-2xl border border-pulse-border overflow-hidden group">
                    <div class="relative h-44 cursor-pointer overflow-hidden" onclick="openVideoModal('${v.title}', '${v.thumbnail}')">
                        <img src="${v.thumbnail}" class="w-full h-full object-cover group-hover:scale-105 transition duration-300 opacity-80">
                        <div class="absolute inset-0 bg-black/40 flex items-center justify-center">
                            <div class="w-12 h-12 rounded-full bg-pulse-crimson/90 text-white flex items-center justify-center shadow-lg group-hover:scale-110 transition">
                                <i class="fa-solid fa-play ml-0.5"></i>
                            </div>
                        </div>
                        <span class="absolute bottom-3 right-3 bg-black/80 text-white text-[10px] font-mono px-2 py-0.5 rounded border border-pulse-border">${v.duration}</span>
                    </div>
                    <div class="p-4">
                        <h3 class="text-sm font-bold text-white">${v.title}</h3>
                        <div class="mt-3 grid grid-cols-3 text-center text-[10px] font-mono bg-pulse-dark p-2 rounded-xl border border-pulse-border">
                            <div><span class="text-slate-500 block">DIST</span><span class="text-white font-bold">${v.distance}</span></div>
                            <div><span class="text-slate-500 block">ELEV</span><span class="text-pulse-yellow font-bold">${v.elevation}</span></div>
                            <div><span class="text-slate-500 block">PACE</span><span class="text-pulse-cyan font-bold">${v.pace}</span></div>
                        </div>
                    </div>
                </div>
            `).join('');
        }

        function renderResults() {
            const filter = document.getElementById('distance-filter').value;
            const filtered = filter === 'All' ? resultsData : resultsData.filter(r => r.distance === filter);
            const tbody = document.getElementById('results-table-body');

            tbody.innerHTML = filtered.map(r => `
                <tr class="${r.name === currentUser.name ? 'bg-pulse-yellow/10 font-bold border-l-2 border-pulse-yellow' : 'hover:bg-slate-900/40'}">
                    <td class="p-4 font-mono font-bold text-pulse-yellow">#${r.rank}</td>
                    <td class="p-4 font-bold text-white flex items-center gap-2">
                        ${r.name}
                        ${r.name === currentUser.name ? '<span class="bg-pulse-yellow text-pulse-dark text-[9px] font-black px-1.5 py-0.5 rounded">YOU</span>' : ''}
                    </td>
                    <td class="p-4 text-pulse-cyan font-semibold">${r.distance}</td>
                    <td class="p-4 font-mono font-bold text-pulse-crimson">${r.time}</td>
                    <td class="p-4 font-mono text-slate-400">${r.pace}</td>
                    <td class="p-4 font-bold uppercase text-slate-400">${r.cat}</td>
                    <td class="p-4 text-center">
                        ${r.pb ? '<span class="bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 text-[10px] px-2 py-0.5 rounded font-mono font-bold">YES (PB)</span>' : '<span class="text-slate-600 text-[10px]">-</span>'}
                    </td>
                </tr>
            `).join('');
        }

        function renderCoaches() {
            const container = document.getElementById('coaches-container');
            container.innerHTML = coachesData.map(c => `
                <div class="bg-pulse-panel p-5 rounded-2xl border border-pulse-border flex flex-col justify-between">
                    <div>
                        <div class="flex items-center gap-3 mb-3">
                            <img src="${c.image}" class="w-10 h-10 rounded-xl object-cover border border-pulse-border">
                            <div>
                                <h3 class="text-sm font-bold text-white">${c.name}</h3>
                                <span class="text-[10px] font-mono font-bold text-pulse-yellow uppercase">${c.role}</span>
                            </div>
                        </div>
                        <p class="text-xs text-slate-400 mb-4 leading-relaxed">${c.desc}</p>
                    </div>
                    <a href="mailto:${c.email}" class="inline-flex items-center justify-center gap-2 text-xs font-bold bg-pulse-dark text-slate-200 hover:text-pulse-yellow p-2 rounded-xl border border-pulse-border hover:border-pulse-yellow transition">
                        <i class="fa-solid fa-envelope text-pulse-yellow"></i>
                        <span>Contact Coach</span>
                    </a>
                </div>
            `).join('');
        }

        function openVideoModal(title, poster) {
            document.getElementById('modal-video-title').innerText = title;
            document.getElementById('modal-video-poster').src = poster;
            document.getElementById('video-modal').classList.remove('hidden');
        }

        function closeVideoModal() {
            document.getElementById('video-modal').classList.add('hidden');
        }

        function copyCode(elementId) {
            const text = document.getElementById(elementId).innerText;
            navigator.clipboard.writeText(text).then(() => {
                alert("Code snippet copied to clipboard!");
            }).catch(() => {
                document.execCommand('copy');
                alert("Code snippet copied to clipboard!");
            });
        }

        // Initialize App on DOM Load
        window.onload = initApp;
    </script>
</body>
</html>